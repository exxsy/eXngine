{
  "configurations": [
    {
      "name": "windows-clang-x64",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/includes/**",
        "${workspaceFolder}/3rdparty/glfw/**",
        "${workspaceFolder}/3rdparty/vulkan/**",
        "${workspaceFolder}/3rdparty/glm/**",
        "${workspaceFolder}/3rdparty/imgui/**",
        // "${workspaceFolder}/3rdparty/fbx/**",
        "\"${env:MICROSOFT_SDK_PATH}\\**\"",
        "\"${env:SDK_PATH}\\**\""
      ],
      "defines": [
        "_DEBUG",
        "_VULKAN",
        "_GLFW_WIN32",
        // "UNICODE",
        "NOMINMAX",
        "EXN_IMAGE_STRATEGY_STBI",
        "GLFW_EXPOSE_NATIVE_WIN32",
        "VK_VERSION_1_0"
      ],
      "compilerPath": "clang",
      "intelliSenseMode": "windows-clang-x64",
      "cStandard": "${default}",
      "cppStandard": "c++20",
      "windowsSdkVersion": "10.0.26100.0",
      "forcedInclude": [
        "includes/eXngine.h"
      ]
    }
  ],
  "version": 4
}